<Window x:Class="homework_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飲料訂購系統" Height="450" Width="600">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="購買方式：" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbDineIn" Content="內用" GroupName="OrderType" IsChecked="True" FontSize="14" Margin="10,0"/>
            <RadioButton x:Name="rbTakeOut" Content="外帶" GroupName="OrderType" FontSize="14" Margin="10,0"/>
        </StackPanel>

        <StackPanel x:Name="DrinkMenuStackPanel" Grid.Row="1">
            <TextBlock Text="選擇飲品與數量：" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="招牌紅茶" FontSize="14" Width="90" VerticalAlignment="Center"/>
                <TextBlock Text="$30" FontSize="14" Width="40" VerticalAlignment="Center"/>
       
                <Slider x:Name="slBlackTea" Width="120" Minimum="0" Maximum="10" TickPlacement="BottomRight" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
              
                <Label Content="{Binding ElementName=slBlackTea, Path=Value}" FontSize="14" Width="30" HorizontalContentAlignment="Center"/>
                <TextBlock Text="杯" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

         
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="珍珠奶茶" FontSize="14" Width="90" VerticalAlignment="Center"/>
                <TextBlock Text="$50" FontSize="14" Width="40" VerticalAlignment="Center"/>
           
                <Slider x:Name="slBoba" Width="120" Minimum="0" Maximum="10" TickPlacement="BottomRight" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
              
                <Label Content="{Binding ElementName=slBoba, Path=Value}" FontSize="14" Width="30" HorizontalContentAlignment="Center"/>
                <TextBlock Text="杯" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,15">
            <CheckBox x:Name="cbDiscount" Content="學生證打9折" FontSize="14" VerticalAlignment="Center" Foreground="Red"/>
            <Button x:Name="OrderButton" Content="送出訂單" Width="100" Height="30" Margin="110,0,0,0" Click="OrderButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtResult" Grid.Row="3" Background="#F0F0F0" FontSize="14" Padding="10" TextWrapping="Wrap"/>
    </Grid>
</Window>